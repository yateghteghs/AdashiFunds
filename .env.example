# Copy to .env (or set in your hosting environment). Required in production are marked *.
NODE_ENV=development
PORT=3000
DB_PATH=data/adashi.db
PUBLIC_BASE_URL=http://localhost:3000

# * 32+ random bytes, e.g. `openssl rand -hex 32`
JWT_SECRET=
# * exactly 32 bytes hex-encoded (64 hex chars), e.g. `openssl rand -hex 32`. Losing it makes encrypted fields unreadable.
DATA_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
# Show OTP codes in API responses (never enabled when NODE_ENV=production)
EXPOSE_DEV_OTP=true

# Payments: mock | paystack
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=

# KYC: mock | manual
KYC_PROVIDER=mock

# Notifications transport: console | memory
NOTIFIER=console

# Fees and rewards
PAYOUT_FEE_BPS=50
TRANSFER_FEE_KOBO=0
REFERRAL_POINTS=100
REFERRAL_BONUS_KOBO=0

# Display-only FX rates (1 NGN = x)
# FX_RATES={"NGN":1,"USD":0.00065,"GHS":0.0098,"XOF":0.39,"KES":0.084}

SCHEDULER_INTERVAL_MS=60000
# Set to true on all but one instance when running several app servers
DISABLE_SCHEDULER=false
